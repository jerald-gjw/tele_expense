[Unit]
Description=Telegram Expense Bot
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/tele_expense
EnvironmentFile=/home/pi/tele_expense/.env
ExecStart=/home/pi/tele_expense/.venv/bin/python /home/pi/tele_expense/run.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
