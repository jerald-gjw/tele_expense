[Unit]
Description=Telegram Expense Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tele_expense
EnvironmentFile=/opt/tele_expense/.env
ExecStart=/opt/tele_expense/.venv/bin/python /opt/tele_expense/run.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
